
@echo off
setlocal EnableExtensions DisableDelayedExpansion

title GCP Resource Discovery

set "ROOT=%~dp0"
set "PROJECT_FILE=%ROOT%projects.txt"
set "OUTPUT=%ROOT%output"

if not exist "%OUTPUT%" mkdir "%OUTPUT%"

echo ==========================================
echo       GCP RESOURCE DISCOVERY
echo ==========================================

REM Check gcloud installation
where gcloud >nul 2>&1
if errorlevel 1 (
    echo ERROR: Google Cloud CLI is not installed.
    pause
    exit /b 1
)

REM Check authentication
gcloud auth list --filter=status:ACTIVE --format="value(account)" >nul 2>&1
if errorlevel 1 (
    echo ERROR: Please run gcloud auth login.
    pause
    exit /b 1
)

REM Check project file
if not exist "%PROJECT_FILE%" (
    echo ERROR: projects.txt not found.
    pause
    exit /b 1
)

echo Project ID,API Enablement,Resources,Enabled Services,Status > "%OUTPUT%\discovery_summary.csv"

REM Read project IDs
for /f "usebackq eol=# tokens=1" %%P in ("%PROJECT_FILE%") do (
    call :PROCESS_PROJECT "%%P"
)

echo.
echo ==========================================
echo       DISCOVERY COMPLETED
echo ==========================================
echo Results saved in: %OUTPUT%

pause
exit /b 0


:PROCESS_PROJECT

set "PROJECT=%~1"
set "DIR=%OUTPUT%\%PROJECT%"

echo.
echo ------------------------------------------
echo Processing project: %PROJECT%
echo ------------------------------------------

if not exist "%DIR%" mkdir "%DIR%"

set "API_STATUS=SUCCESS"
set "RESOURCE_STATUS=SUCCESS"
set "SERVICE_STATUS=SUCCESS"

REM STEP 1: Enable Cloud Asset Inventory API
echo Enabling Cloud Asset Inventory API...

gcloud services enable cloudasset.googleapis.com ^
 --project=%PROJECT% ^
 --quiet > "%DIR%\api_enable.log" 2>&1

if errorlevel 1 (
    echo API enablement failed.
    set "API_STATUS=FAILED"
    goto SAVE_SUMMARY
)

REM STEP 2: Collect all project resources
echo Collecting project resources...

gcloud asset search-all-resources ^
 --scope=projects/%PROJECT% ^
 --format=json > "%DIR%\resources.json" 2> "%DIR%\resource_errors.log"

if errorlevel 1 (
    echo Resource discovery failed.
    echo [] > "%DIR%\resources.json"
    set "RESOURCE_STATUS=FAILED"
)

REM STEP 3: Collect enabled GCP services
echo Collecting enabled GCP services...

gcloud services list ^
 --enabled ^
 --project=%PROJECT% ^
 --format=json > "%DIR%\enabled_services.json" 2> "%DIR%\service_errors.log"

if errorlevel 1 (
    echo Service discovery failed.
    echo [] > "%DIR%\enabled_services.json"
    set "SERVICE_STATUS=FAILED"
)

:SAVE_SUMMARY

echo %PROJECT%,%API_STATUS%,%RESOURCE_STATUS%,%SERVICE_STATUS% >> "%OUTPUT%\discovery_summary.csv"

echo.
echo Completed project: %PROJECT%
echo API: %API_STATUS%
echo Resources: %RESOURCE_STATUS%
echo Services: %SERVICE_STATUS%

exit /b 0
